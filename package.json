{
  "name": "liftbox",
  "version": "1.3.4",
  "description": "Accessible React gallery and lightbox with zoom, thumbnails, video and slideshow. Zero runtime dependencies, themeable with CSS variables.",
  "license": "MIT",
  "author": "Esdras Santos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esdrassantos06/liftbox.git"
  },
  "homepage": "https://liftbox.digital",
  "bugs": "https://github.com/esdrassantos06/liftbox/issues",
  "keywords": [
    "react",
    "lightbox",
    "gallery",
    "photo-gallery",
    "masonry",
    "justified",
    "zoom",
    "accessible",
    "nextjs",
    "react-lightbox",
    "image-viewer",
    "photo-viewer",
    "slideshow",
    "video"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit false --emitDeclarationOnly --outDir node_modules/.cache/typecheck && tsc -p playground/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.66.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
